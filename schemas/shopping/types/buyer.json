{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bcp.dev.br/schemas/shopping/types/buyer.json",
  "title": "Buyer",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "first_name": {
      "type": "string",
      "description": "First name of the buyer.",
      "description_pt": "Primeiro nome do buyer."
    },
    "last_name": {
      "type": "string",
      "description": "Last name of the buyer.",
      "description_pt": "Sobrenome do buyer."
    },
    "email": {
      "type": "string",
      "description": "Email of the buyer.",
      "description_pt": "E-mail do buyer."
    },
    "phone_number": {
      "type": "string",
      "description": "E.164 standard.",
      "description_pt": "Padrão E.164."
    }
  }
}
