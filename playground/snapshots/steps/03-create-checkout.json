      "actor": "buyer_agent",
      "actor_label": {
        "pt-BR": "Agente cliente",
        "en": "Buyer agent"
      },
      "text": {
        "pt-BR": "Vou me conectar à Loja Vermelho e verificar o que ela oferece.",
        "en": "I will connect to Loja Vermelho and check what it offers."
