  "title": {
    "pt-BR": "Buscar e escolher o produto",
    "en": "Search and choose the product"
  },
  "narrative": {
    "pt-BR": "A busca e a resposta usam texto porque o BCP não define binding A2A de catálogo. A escolha humana ainda não altera o checkout.",
    "en": "Search and response use text because BCP does not define an A2A catalog binding. The human choice does not modify the checkout yet."
  },
