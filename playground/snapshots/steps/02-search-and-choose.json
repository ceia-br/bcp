    {
      "actor": "client",
      "actor_label": {
        "pt-BR": "Cliente",
        "en": "Customer"
      },
      "text": {
        "pt-BR": "Quero uma camiseta vermelha, tamanho M.",
        "en": "I want a red T-shirt, size M."
      }
    },
    {
      "actor": "buyer_agent",
      "actor_label": {
        "pt-BR": "Agente cliente",
        "en": "Buyer agent"
      },
      "text": {
        "pt-BR": "Vou me conectar à Loja Vermelho e verificar o que ela oferece.",
        "en": "I will connect to Loja Vermelho and check what it offers."
      }
    },
    {
      "actor": "buyer_agent",
      "actor_label": {
        "pt-BR": "Agente cliente",
        "en": "Buyer agent"
      },
      "text": {
        "pt-BR": "Encontrei a Camiseta Vermelha M por R$ 59,90.",
        "en": "I found the Red T-shirt M for BRL 59.90."
      }
    },
    {
      "actor": "client",
      "actor_label": {
        "pt-BR": "Cliente",
